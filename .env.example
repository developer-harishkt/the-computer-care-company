# Copy to .env.local and fill in (never commit .env.local).

# Production site origin (no trailing slash). Used in canonical, Open Graph, and JSON-LD at build time.
# Also set VITE_SITE_URL in Cloudflare Pages build environment variables.
VITE_SITE_URL=https://thecomputercarecompany.in

# Google Apps Script web app URL (Deploy → Web app → /exec)
VITE_BOOKINGS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Phase C — Razorpay test Key ID (public; from Dashboard → Settings → API Keys, Test mode)
VITE_RAZORPAY_KEY_ID=rzp_test_...

# Apps Script → Project settings → Script properties (not in git):
#   RAZORPAY_KEY_ID = same as VITE_RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET = from API Keys CSV (shown once)
